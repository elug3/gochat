{
    "$schema": "https://www.krakend.io/schema/v2.10/krakend.json",
    "version": 3,
    "debug_endpoint": true,
    "endpoints": [
        {
            "endpoint": "/register",
            "method": "POST",
            "backend": [
                {
                    "method": "POST",
                    "url_pattern": "/register",
                    "host": ["auth:8080"]
                }
            ]
        },
        {
            "endpoint": "/login",
            "method": "POST",
            "output_encoding": "no-op",
            "input_headers": ["Authorization"],
            "backend": [
                {
                    "method": "POST",
                    "url_pattern": "/login",
                    "host": ["auth:8080"]
                }
            ]
        },
        {
            "endpoint": "/auth/ws",
            "method": "POST",
            "input_headers": ["Authorization"],
            "output_encoding": "no-op",
            "backend": [
                {
                    "method": "POST",
                    "url_pattern": "/ws",
                    "host": ["auth:8080"]
                }
            ]
        },
        {
            "endpoint": "/auth/ws",
            "method": "GET",
            "input_query_strings": ["token"],
            "output_encoding": "no-op",
            "backend": [
                {
                    "method": "GET",
                    "url_pattern": "/ws",
                    "host": ["auth:8080"]
                }
            ]
        },
        {
            "endpoint": "/user",
            "method": "GET",
            "extra_config": {
                "auth/validator": {
                    "alg": "RS256",
                    "operation_debug": true,
                    "key_identify_strategy": "kid",
                    "audience": [
                        "api"
                    ],
                    "disable_jwk_security": true,
                    "jwk_url": "http://auth/.well-known/jwks.json",
                    "cache": false
                }
            },
            "backend": [
                {
                    "method": "GET",
                    "url_pattern": "/user",
                    "host": ["user:8080"]

                }
            ]
        },


        
        {
            "endpoint": "/groups",
            "@comment": "List all groups of the authenticated user",
            "method": "GET",
            "output_encoding": "no-op",
            "extra_config": {
                "auth/validator": {
                    "alg": "RS256",
                    "operation_debug": true,
                    "key_identify_strategy": "kid",
                    "audience": ["api"],
                    "disable_jwk_security": true,
                    "jwk_url": "http://auth:8080/.well-known/jwks.json",
                    "cache": false
                }
            },
            "backend": [
                {
                    "method": "GET",
                    "url_pattern": "/user/{JWT.sub}/groups",
                    "host": ["contacts:8080"]
                }
            ]
        },
        {
            "endpoint": "/groups",
            "@comment": "Create a new group",
            "method": "POST",
            "output_encoding": "no-op",
            "extra_config": {
                "auth/validator": {
                    "alg": "RS256",
                    "operation_debug": true,
                    "key_identify_strategy": "kid",
                    "audience": ["api"],
                    "disable_jwk_security": true,
                    "jwk_url": "http://auth:8080/.well-known/jwks.json",
                    "cache": false
                }
            },
            "backend": [
                {
                    "method": "POST",
                    "url_pattern": "/user/{JWT.sub}/groups",
                    "host": ["contacts:8080"]
                }
            ]
        },
        {
            "endpoint": "/groups/{groupId}/members",
            "@comment": "Get all members of a group",
            "output_encoding": "no-op",
            "extra_config": {
                "auth/validator": {
                    "alg": "RS256",
                    "operation_debug": true,
                    "key_identify_strategy": "kid",
                    "audience": ["api"],
                    "disable_jwk_security": true,
                    "jwk_url": "http://auth:8080/.well-known/jwks.json",
                    "cache": false
                }
            },
            "method": "GET",
            "backend": [
                {
                    "method": "GET",
                    "url_pattern": "/user/{JWT.sub}/groups/{groupId}/members",
                    "host": ["contacts:8080"]
                }
            ]
        },
        {
            "endpoint": "/groups/{groupId}/members",
            "@comment": "Add a new member to a group",
            "method": "POST",
            "output_encoding": "no-op",
            "extra_config": {
                "auth/validator": {
                    "alg": "RS256",
                    "operation_debug": true,
                    "key_identify_strategy": "kid",
                    "audience": ["api"],
                    "disable_jwk_security": true,
                    "jwk_url": "http://auth:8080/.well-known/jwks.json",
                    "cache": false
                }
            },
            "backend": [
                {
                    "method": "POST",
                    "url_pattern": "/user/{JWT.sub}/groups/{groupId}/members",
                    "host": ["contacts:8080"]
                }
            ]
        },
        {
            "endpoint": "/groups/{groupId}/members/{memberId}",
            "@comment": "Remove a member from a group",
            "method": "DELETE",
            "output_encoding": "no-op",
            "extra_config": {
                "auth/validator": {
                    "alg": "RS256",
                    "operation_debug": true,
                    "key_identify_strategy": "kid",
                    "audience": ["api"],
                    "disable_jwk_security": true,
                    "jwk_url": "http://auth:8080/.well-known/jwks.json",
                    "cache": false 
                }  
            },
            "backend": [
                {
                    "method": "DELETE",
                    "url_pattern": "/user/{JWT.sub}/groups/{groupId}/members/{memberId}",
                    "host": ["contacts:8080"]   
                }
            ]
        },



        {
            "endpoint": "/messages",
            "@comment": "Send a message to a chat",
            "method": "POST",
            "output_encoding": "no-op",
            "extra_config": {
                "auth/validator": {
                    "alg": "RS256",
                    "operation_debug": true,
                    "key_identify_strategy": "kid",
                    "audience": ["api"],
                    "disable_jwk_security": true,
                    "jwk_url": "http://auth:8080/.well-known/jwks.json",
                    "cache": false  
                }  
            },
            "backend": [
                {
                    "method": "POST",
                    "url_pattern": "/user/{JWT.sub}/messages",
                    "host": ["messages:8080"]
                }
            ]
        },
        {
            "endpoint": "/chats/{chatId}/messages",
            "@comment": "Get all messages from a messages",
            "method": "GET",
            "output_encoding": "no-op",
            "extra_config": {
                "auth/validator": {
                    "alg": "RS256",
                    "operation_debug": true,
                    "key_identify_strategy": "kid",
                    "audience": ["api"],
                    "disable_jwk_security": true,
                    "jwk_url": "http://auth:8080/.well-known/jwks.json",
                    "cache": false  
                }  
            },
            "backend": [
                {
                    "method": "GET",
                    "url_pattern": "/user/{JWT.sub}/chat/{chatId}/messages",
                    "host": ["messages:8080"]
                }
            ]
        },




        {
            "endpoint": "/chats",
            "@comment": "List all chats of the authenticated user",
            "method": "GET",
            "output_encoding": "no-op",
            "extra_config": {
                "auth/validator": {
                    "alg": "RS256",
                    "operation_debug": true,
                    "key_identify_strategy": "kid",
                    "audience": ["api"],
                    "disable_jwk_security": true,
                    "jwk_url": "http://auth:8080/.well-known/jwks.json",
                    "cache": false 
                }
            },
            "backend": [
                {
                    "method": "GET",
                    "url_pattern": "/user/{JWT.sub}/chats",
                    "host": ["chatview:8080"]
                }
            ]
        }
    ]
}
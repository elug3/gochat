{
    "$schema": "https://www.krakend.io/schema/v2.10/krakend.json",
    "version": 3,
    "debug_endpoint": true,
    "extra_config": {
        "security/cors": {
            "allow_methods": [
                "POST",
                "GET",
                "OPTIONS"
            ],
            "allow_origins": ["*"],
            "allow_headers": ["Content-Type", "Authorization"],
            "expose_headers": ["Content-Type", "Authorization"],
            "allow_credentials": true,
            "debug": true
        }
    },
    "endpoints": [
        {
            "endpoint": "/me",
            "method": "GET",
            "output_encoding": "no-op",
            "input_headers": ["Authorization"],
            "backend": [
                {
                    "method": "GET",
                    "url_pattern": "/me",
                    "host": ["auth:8080"]
                }
            ]
        },
        {
            "endpoint": "/register",
            "method": "POST",
            "output_encoding": "no-op",
            "backend": [
                {
                    "method": "POST",
                    "url_pattern": "/register",
                    "host": ["auth:8080"]
                }
            ]
        },
        {
            "endpoint": "/login",
            "method": "POST",
            "output_encoding": "no-op",
            "input_headers": ["Authorization"],
            "backend": [
                {
                    "method": "POST",
                    "url_pattern": "/login",
                    "host": ["auth:8080"]
                }
            ]
        },
        {
            "endpoint": "/webauthn/register/begin",
            "method": "POST",
            "output_encoding": "no-op",
            "input_headers": ["Authorization"],
            "backend": [
                {
                    "method": "POST",
                    "url_pattern": "/webauthn/register/begin",
                    "input_headers": ["Authorization"],
                    "host": ["auth:8080"]
                }
            ],
            "extra_config": {
                "security/cors": {
                    "options_passthrough": true,
                    "allow_methods": ["POST", "OPTIONS"],
                    "options_success_status": 200
                }
            }
        },
        {
            "endpoint": "/webauthn/register/finish",
            "method": "POST",
            "output_encoding": "no-op",
            "input_headers": ["Authorization"],
            "backend": [
                {
                    "method": "POST",
                    "input_headers": ["Authorization"],
                    "url_pattern": "/webauthn/register/finish",
                    "host": ["auth:8080"]
                }
            ]
        },
        {
            "endpoint": "/webauthn/login/begin",
            "method": "POST",
            "output_encoding": "no-op",
            "backend": [
                {
                    "method": "POST",
                    "url_pattern": "/webauthn/login/begin",
                    "host": ["auth:8080"]
                }
            ]
        },
        {
            "endpoint": "/webauthn/login/finish",
            "method": "POST",
            "output_encoding": "no-op",
            "backend": [
                {
                    "method": "POST",
                    "url_pattern": "/webauthn/login/finish",
                    "host": ["auth:8080"]
                }
            ]
        },
        {
            "endpoint": "/webauthn/passkeys",
            "method": "GET",
            "output_encoding": "no-op",
            "input_headers": ["Authorization"],
            "backend": [
                {
                    "method": "GET",
                    "input_headers": ["Authorization"],
                    "url_pattern": "/webauthn/passkeys",
                    "host": ["auth:8080"]
                }
            ]
        },
        {
            "endpoint": "/auth/ws",
            "method": "POST",
            "input_headers": ["Authorization"],
            "output_encoding": "no-op",
            "backend": [
                {
                    "method": "POST",
                    "url_pattern": "/ws",
                    "host": ["auth:8080"]
                }
            ]
        },
        {
            "endpoint": "/auth/ws",
            "method": "GET",
            "input_query_strings": ["token"],
            "output_encoding": "no-op",
            "backend": [
                {
                    "method": "GET",
                    "url_pattern": "/ws",
                    "host": ["auth:8080"]
                }
            ]
        },
        {
            "endpoint": "/user",
            "method": "GET",
            "extra_config": {
                "auth/validator": {
                    "alg": "RS256",
                    "operation_debug": true,
                    "key_identify_strategy": "kid",
                    "audience": [
                        "api"
                    ],
                    "disable_jwk_security": true,
                    "jwk_url": "http://auth/.well-known/jwks.json",
                    "cache": false
                }
            },
            "backend": [
                {
                    "method": "GET",
                    "url_pattern": "/user",
                    "host": ["user:8080"]
                }
            ]
        },

        {
            "endpoint": "/profile",
            "@comment": "Get the profile of the authenticated user",
            "method": "GET",
            "backend": [
                {
                    "method": "GET",
                    "url_pattern": "/user/{JWT.sub}/profile",
                    "host": ["contacts:8080"]
                },
                {
                    "method": "GET",
                    "url_pattern": "/users/{JWT.sub}/presence",
                    "host": ["presence:8080"],
                    "encoding": "json",
                    "mapping": {
                        "user_id": "id"
                    }
                }
            ],
            "extra_config": {
                "auth/validator": {
                    "alg": "RS256",
                    "operation_debug": true,
                    "key_identify_strategy": "kid",
                    "audience": ["api"],
                    "disable_jwk_security": true,
                    "jwk_url": "http://auth:8080/.well-known/jwks.json",
                    "cache": false
                }
            }
        },

        {
            "endpoint": "/contacts",
            "@comment": "Get all contacts of the authenticated user",
            "method": "GET",
            "output_encoding": "no-op",
            "backend": [
                {
                    "method": "GET",
                    "url_pattern": "/user/{JWT.sub}/contacts",
                    "host": ["contacts:8080"]
                }
            ],
            "extra_config": {
                
                "auth/validator": {
                    "alg": "RS256",
                    "operation_debug": true,
                    "key_identify_strategy": "kid",
                    "audience": ["api"],
                    "disable_jwk_security": true,
                    "jwk_url": "http://auth:8080/.well-known/jwks.json",
                    "cache": false
                }
            }
        },
        {
            "endpoint": "/contacts",
            "@comment": "Add a new contact to the authenticated user",
            "method": "POST",
            "output_encoding": "no-op",
            "backend": [
                {
                    "method": "POST",
                    "url_pattern": "/user/{JWT.sub}/contacts",
                    "host": ["contacts:8080"]
                }
            ],
            "extra_config": {
                "auth/validator": {
                    "alg": "RS256",
                    "operation_debug": true,
                    "key_identify_strategy": "kid",
                    "audience": ["api"],
                    "disable_jwk_security": true,
                    "jwk_url": "http://auth:8080/.well-known/jwks.json",
                    "cache": false
                }
            }
        },

        {
            "endpoint": "/groups",
            "@comment": "List all groups of the authenticated user",
            "method": "GET",
            "output_encoding": "no-op",
            "extra_config": {
                "auth/validator": {
                    "alg": "RS256",
                    "operation_debug": true,
                    "key_identify_strategy": "kid",
                    "audience": ["api"],
                    "disable_jwk_security": true,
                    "jwk_url": "http://auth:8080/.well-known/jwks.json",
                    "cache": false
                }
            },
            "backend": [
                {
                    "method": "GET",
                    "url_pattern": "/user/{JWT.sub}/groups",
                    "host": ["contacts:8080"]
                }
            ]
        },
        {
            "endpoint": "/groups",
            "@comment": "Create a new group",
            "method": "POST",
            "output_encoding": "no-op",
            "extra_config": {
                "auth/validator": {
                    "alg": "RS256",
                    "operation_debug": true,
                    "key_identify_strategy": "kid",
                    "audience": ["api"],
                    "disable_jwk_security": true,
                    "jwk_url": "http://auth:8080/.well-known/jwks.json",
                    "cache": false
                }
            },
            "backend": [
                {
                    "method": "POST",
                    "url_pattern": "/user/{JWT.sub}/groups",
                    "host": ["contacts:8080"]
                }
            ]
        },
        {
            "endpoint": "/groups/{groupId}/members",
            "@comment": "Get all members of a group",
            "output_encoding": "no-op",
            "extra_config": {
                "auth/validator": {
                    "alg": "RS256",
                    "operation_debug": true,
                    "key_identify_strategy": "kid",
                    "audience": ["api"],
                    "disable_jwk_security": true,
                    "jwk_url": "http://auth:8080/.well-known/jwks.json",
                    "cache": false
                }
            },
            "method": "GET",
            "backend": [
                {
                    "method": "GET",
                    "url_pattern": "/user/{JWT.sub}/groups/{groupId}/members",
                    "host": ["contacts:8080"]
                }
            ]
        },
        {
            "endpoint": "/groups/{groupId}/members",
            "@comment": "Add a new member to a group",
            "method": "POST",
            "output_encoding": "no-op",
            "extra_config": {
                "auth/validator": {
                    "alg": "RS256",
                    "operation_debug": true,
                    "key_identify_strategy": "kid",
                    "audience": ["api"],
                    "disable_jwk_security": true,
                    "jwk_url": "http://auth:8080/.well-known/jwks.json",
                    "cache": false
                }
            },
            "backend": [
                {
                    "method": "POST",
                    "url_pattern": "/user/{JWT.sub}/groups/{groupId}/members",
                    "host": ["contacts:8080"]
                }
            ]
        },
        {
            "endpoint": "/groups/{groupId}/members/{memberId}",
            "@comment": "Remove a member from a group",
            "method": "DELETE",
            "output_encoding": "no-op",
            "extra_config": {
                "auth/validator": {
                    "alg": "RS256",
                    "operation_debug": true,
                    "key_identify_strategy": "kid",
                    "audience": ["api"],
                    "disable_jwk_security": true,
                    "jwk_url": "http://auth:8080/.well-known/jwks.json",
                    "cache": false 
                }  
            },
            "backend": [
                {
                    "method": "DELETE",
                    "url_pattern": "/user/{JWT.sub}/groups/{groupId}/members/{memberId}",
                    "host": ["contacts:8080"]   
                }
            ]
        },



        {
            "endpoint": "/messages",
            "@comment": "Send a message to a chat",
            "method": "POST",
            "output_encoding": "no-op",
            "extra_config": {
                "auth/validator": {
                    "alg": "RS256",
                    "operation_debug": true,
                    "key_identify_strategy": "kid",
                    "audience": ["api"],
                    "disable_jwk_security": true,
                    "jwk_url": "http://auth:8080/.well-known/jwks.json",
                    "cache": false  
                }  
            },
            "backend": [
                {
                    "method": "POST",
                    "url_pattern": "/user/{JWT.sub}/messages",
                    "host": ["messages:8080"]
                }
            ]
        },
        {
            "endpoint": "/chats/{chatId}/messages",
            "@comment": "Get all messages from a messages",
            "method": "GET",
            "output_encoding": "no-op",
            "extra_config": {
                "auth/validator": {
                    "alg": "RS256",
                    "operation_debug": true,
                    "key_identify_strategy": "kid",
                    "audience": ["api"],
                    "disable_jwk_security": true,
                    "jwk_url": "http://auth:8080/.well-known/jwks.json",
                    "cache": false  
                }  
            },
            "backend": [
                {
                    "method": "GET",
                    "url_pattern": "/user/{JWT.sub}/chat/{chatId}/messages",
                    "host": ["messages:8080"]
                }
            ]
        },
        {
            "endpoint": "/chats/{chatId}/participants",
            "@comment": "Get all participants of a chat",
            "method": "GET",
            "output_encoding": "no-op",
            "backend": [
                {
                    "method": "GET",
                    "url_pattern": "/user/{JWT.sub}/groups/{chatId}/members",
                    "host": ["contacts:8080"]
                }
            ],
            "extra_config": {
                "auth/validator": {
                    "alg": "RS256",
                    "operation_debug": true,
                    "key_identify_strategy": "kid",
                    "audience": ["api"],
                    "disable_jwk_security": true,
                    "jwk_url": "http://auth:8080/.well-known/jwks.json",
                    "cache": false 
                }
            }
        },
        {
            "endpoint": "/chats",
            "@comment": "List all chats of the authenticated user",
            "method": "GET",
            "output_encoding": "no-op",
            "extra_config": {
                "auth/validator": {
                    "alg": "RS256",
                    "operation_debug": true,
                    "key_identify_strategy": "kid",
                    "audience": ["api"],
                    "disable_jwk_security": true,
                    "jwk_url": "http://auth:8080/.well-known/jwks.json",
                    "cache": false 
                }
            },
            "backend": [
                {
                    "method": "GET",
                    "url_pattern": "/user/{JWT.sub}/chats",
                    "host": ["chatview:8080"]
                }
            ]
        }
    ]
}